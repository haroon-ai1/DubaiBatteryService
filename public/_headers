# Cloudflare Workers Static Assets reads this file.
# Verify after deploy with: curl -sI https://dubaibatteryservice.com/ | sort

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  # 'unsafe-inline' is required for script-src because Astro inlines the
  # small progressive-enhancement scripts and the GA bootstrap, and for
  # style-src because Astro emits scoped <style> blocks. Tighten to
  # per-build hashes only if you move to an SSR adapter that can emit a
  # nonce — a static build cannot.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; upgrade-insecure-requests

# Content-hashed by Vite — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate so a content fix goes live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
