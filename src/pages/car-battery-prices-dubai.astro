---
/*
  /car-battery-prices-dubai/

  This page previously carried a "Car Battery Prices in Dubai" title and
  meta description over a body that was a general battery-service
  overview — H1 "Car Battery Service in Dubai.", breadcrumb "Car Battery
  Service", and not one price, cost or AED figure anywhere in it. Title
  and intent are now aligned, and the service-taxonomy content that used
  to live here is compressed into a "which visit do I need" section that
  links out rather than competing with the service pages.

  Price bands come from `siteConfig.pricing` and render as clearly-labelled
  indicative RANGES with a review date. They are never presented as quotes.
*/
import ServicePageLayout from "@/layouts/ServicePageLayout.astro";
import FaqBlock from "@/components/seo/FaqBlock.astro";
import ServiceImage from "@/components/service/ServiceImage.astro";
import WhatsAppButton from "@/components/actions/WhatsAppButton.astro";
import { hasWhatsAppChannel } from "@/lib/leads";
import { siteConfig } from "@/config/site";
import type { RelatedItem } from "@/layouts/ServicePageLayout.astro";

const hasWhatsApp = hasWhatsAppChannel();
const { pricing, currency } = siteConfig;

const reviewed = new Date(pricing.lastReviewed).toLocaleDateString("en-GB", {
  month: "long",
  year: "numeric",
});

const related: RelatedItem[] = [
  {
    service: "battery_replacement",
    href: "/car-battery-replacement-dubai/",
    blurb: "The specification that decides both the price and how long it lasts.",
  },
  {
    service: "battery_testing",
    href: "/battery-testing-dubai/",
    blurb: "Cheaper than a replacement, and it tells you whether you need one.",
  },
  {
    service: "mobile_battery_service",
    href: "/mobile-battery-service-dubai/",
    blurb: "Testing, replacement and BMS work carried out at the vehicle.",
  },
];

/*
  Rendered by <FaqBlock>, which emits the visible <details> list and the
  FAQPage JSON-LD from this one array — so schema can never describe a
  question the page doesn't show.
*/
const faqs = [
  {
    q: "How much does a car battery cost in Dubai?",
    a: 'For most cars, somewhere between AED 220 and AED 2,000 supplied and fitted, and the spread is not arbitrary — it tracks chemistry and capacity. A small conventional battery for a car without stop-start sits at the bottom of that range. A large AGM for a Patrol or Land Cruiser sits at the top. The band table on this page breaks it down by specification, but the figure for your car is decided by what the manufacturer specified, not by what you would prefer to spend.',
  },
  {
    q: "Why is an AGM battery so much more expensive than a conventional one?",
    a: 'Construction cost. An AGM battery holds its electrolyte in a glass-mat separator under compression in a sealed case, which tolerates deep cycling and high electrical loads that would finish a flooded battery quickly. If your car was engineered around AGM, fitting a cheaper flooded battery to save money typically buys you a replacement again within months, so the saving is not real. <a href="/car-battery-replacement-dubai/">Battery replacement</a> covers why the specification is not negotiable.',
  },
  {
    q: "Is mobile battery replacement more expensive than going to a workshop?",
    a: "Not usually by much, and often not at all. Most mobile providers include on-site fitting in the quoted price because fitting a battery takes minutes and the van is already going out. Where a genuine premium does appear is out-of-hours and emergency work: a 2 a.m. roadside call-out is priced differently from a scheduled afternoon visit. Against that, a workshop visit has its own cost, since a car that will not start needs recovery or a taxi.",
  },
  {
    q: "What should I ask before accepting a battery quote?",
    a: "Five things: is fitting included, what chemistry and capacity is actually being supplied, does the price cover BMS registration if your car needs it, how long is the warranty and is it pro-rata or full replacement, and is the old battery being taken away or deducted. Two quotes that look identical on the headline number can be quite different once those are answered.",
  },
  {
    q: "Are the prices on this page a quote?",
    a: "No. They are indicative market ranges for Dubai, published so you can sanity-check what you are being told, and they are reviewed periodically rather than live. A real figure for your car needs the make, model, year and the current battery's specification. Send those over and you get an actual number rather than a range.",
  },
];
---

<ServicePageLayout
  service="battery_prices"
  title="Car Battery Prices in Dubai | Dubai Battery Service"
  description="What a car battery costs in Dubai by type and size, what pushes a quote up, and the five questions that make two quotes actually comparable."
  path="/car-battery-prices-dubai/"
  eyebrow="07 · Prices"
  h1="Car Battery Prices in Dubai."
  standfirst="Battery quotes in Dubai vary by a factor of ten, and most of that spread is real rather than markup — chemistry, capacity and fitment complexity are set by the vehicle. What follows is what a battery actually costs here, what moves the number, and how to compare two quotes without guessing."
  breadcrumbLabel="Car Battery Prices"
  finalHeadingSubject="a price for your car"
  schemaName="Car Battery Replacement Pricing in Dubai"
  related={related}
>
  <h2>What a car battery costs in Dubai</h2>
  <p>
    The ranges below cover the battery supplied and fitted at the vehicle, for the
    common specifications on Dubai roads. They are indicative market ranges, not
    quotes — the point is to give you something to measure a quote against, not to
    price your car sight-unseen.
  </p>

  {
    pricing.showBands && (
      <>
        <div class="price-table-wrap">
          <table class="price-table">
            <caption class="visually-hidden">
              Indicative car battery price ranges in Dubai by battery type and capacity
            </caption>
            <thead>
              <tr>
                <th scope="col">Battery type</th>
                <th scope="col">Capacity</th>
                <th scope="col">Typically fits</th>
                <th scope="col" class="num">
                  Range ({currency})
                </th>
              </tr>
            </thead>
            <tbody>
              {pricing.bands.map((band) => (
                <tr>
                  <th scope="row">{band.label}</th>
                  <td>{band.spec}</td>
                  <td class="fits">{band.fits}</td>
                  <td class="num">
                    {band.low.toLocaleString("en-AE")}–{band.high.toLocaleString("en-AE")}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="price-note">
          Indicative ranges for supply and standard on-site fitting in Dubai, reviewed{" "}
          {reviewed}. Not a quote and not a price list — your car's actual figure
          depends on the specification covered below.
        </p>
      </>
    )
  }

  <h2>What actually moves the number</h2>

  <h3>Chemistry — the single biggest factor</h3>
  <p>
    Conventional flooded, EFB and AGM are three different products at three different
    price points, and which one your car takes is a manufacturer decision rather than
    a preference. A stop-start car specified for AGM will physically accept a cheap
    flooded battery, start on it, and destroy it inside months, because the cycling
    duty it was never built for finishes it. That is the most common way a driver ends
    up paying twice. The <a href="/car-battery-replacement-dubai/">replacement page</a>
    covers how to identify what your car requires.
  </p>

  <h3>Capacity and cold-cranking amps</h3>
  <p>
    Amp-hours and CCA are set by the vehicle's electrical demand. A large SUV with a
    big engine, a second battery circuit or heavy accessory load needs a physically
    larger, more expensive cell than a small saloon. Going below the specified figure
    to save money produces slow cranking and a battery working permanently at its
    limit, which in this climate means a short life.
  </p>

  <h3>Fitment complexity</h3>
  <p>
    A battery sitting under the bonnet on an open tray is a fast job. A battery under a
    seat, in the boot floor, behind a wheel-arch liner or under a cover requiring trim
    removal is not, and where labour is priced separately that difference shows up.
    Modern German cars are the common case.
  </p>

  <h3>BMS registration</h3>
  <p>
    Many cars with battery management need the new battery registered or coded so the
    charging strategy matches it. Skipping the step does not stop the car starting — it
    quietly leaves the alternator charging to the old battery's profile, which shortens
    the new one's life. Some quotes include registration, some add it, and some omit it
    without mentioning it. Worth asking directly.
  </p>

  <h3>When and where the call happens</h3>
  <p>
    A scheduled daytime visit to a parking bay is priced differently from a 2 a.m.
    hard-shoulder <a href="/emergency-battery-service-dubai/">emergency call-out</a>.
    That premium is a real cost rather than a markup, but it is worth knowing it exists
    so a night quote and a daytime quote are not compared as though they were the same
    job.
  </p>

  <div class="extras">
    <h3 class="extras-title">Line items that change a comparison</h3>
    <dl class="extras-list">
      {
        pricing.extras.map((item) => (
          <div class="extras-row">
            <dt>{item.label}</dt>
            <dd>{item.note}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <ServiceImage service="battery_prices" slotName="detail" />

  <h2>How to compare two quotes honestly</h2>
  <p>
    Headline numbers are close to meaningless on their own. Ask both providers the same
    five questions and the cheaper quote usually stops being the cheaper quote, or
    becomes obviously the better one:
  </p>
  <ol>
    <li>What chemistry and capacity is being supplied — exactly?</li>
    <li>Is on-site fitting included in that figure?</li>
    <li>Does it cover BMS registration, if my car needs it?</li>
    <li>What is the warranty term, and is it full replacement or pro-rata?</li>
    <li>Is the old battery taken away, and is its scrap value deducted?</li>
  </ol>
  <p>
    A brand name is a much weaker signal than the answers to those five. A well-known
    brand in the wrong specification is a worse purchase than an unfamiliar one in the
    right specification.
  </p>

  <h2>Where the cheapest quote costs more</h2>
  <p>
    Battery pricing has an unusual property: the cheap option frequently costs more
    within the same year, because the failure mode is early replacement rather than
    poor performance. Three patterns account for most of it.
  </p>
  <ul>
    <li>
      A flooded battery fitted where the maker specified EFB or AGM. Cheapest at
      purchase, often replaced inside twelve months.
    </li>
    <li>
      A battery replaced without a <a href="/battery-testing-dubai/">test</a> first,
      when the real fault was an alternator or a parasitic drain. The new battery
      flattens the same way and the money is simply gone.
    </li>
    <li>
      Old stock. A lead-acid battery ages on the shelf, and a cell that has sat for a
      year in a warehouse starts life partly used up. The date code is worth asking
      about.
    </li>
  </ul>
  <p>
    The useful frame is cost per year of service, not cost at the counter. An AGM at
    AED 900 that runs four years is cheaper than AED 400 twice in eighteen months, and
    it does not strand you in between.
  </p>

  <h2>What the UAE climate changes about the picture</h2>
  <p>
    Lead-acid chemistry ages faster in heat, and manufacturer-quoted service lives are
    measured against a temperate baseline. A conventional starter battery in a Dubai
    car typically runs closer to two or three years than the four or five sometimes
    quoted. AGM tends to last longer because the sealed construction better contains
    the water loss that finishes a flooded battery. That changes the arithmetic above:
    the premium chemistry recovers its extra cost faster here than it would in Europe.
  </p>
  <p>
    Failure mode matters too. Batteries here more often fail suddenly than gradually —
    a car that started fine yesterday is gone by morning. Replacing on age, before the
    failure, is usually cheaper than replacing during one, because it takes the
    emergency call-out premium off the bill entirely.
  </p>

  <h2>Which visit do you actually need?</h2>
  <p>
    Price only becomes meaningful once you know what you are buying. Four situations
    cover almost everything:
  </p>
  <ul>
    <li>
      <strong>First time it won't start, no prior warning.</strong> Usually an
      event-driven flat, such as a light left on or a door ajar. A
      <a href="/jump-start-dubai/">jump-start</a> and a normal drive, and the story
      ends there.
    </li>
    <li>
      <strong>Cranking weakly for days, now dead.</strong> The failing-battery pattern.
      A <a href="/battery-testing-dubai/">test</a> confirms it and a
      <a href="/car-battery-replacement-dubai/">replacement</a> is the answer.
    </li>
    <li>
      <strong>Keeps going flat despite normal driving.</strong> Often not the battery
      at all, but a parasitic drain or an alternator not fully recharging. A test on
      the wider charging circuit comes first; fitting a battery without it repeats the
      failure at full price.
    </li>
    <li>
      <strong>Stranded somewhere it can't stay.</strong> An
      <a href="/emergency-battery-service-dubai/">emergency call-out</a>, or a
      <a href="/mobile-battery-service-dubai/">mobile visit</a> if the car is parked
      safely.
    </li>
  </ul>
  <p>
    One case sits outside all of this. A suspected alternator or starter-motor fault,
    or a hybrid high-voltage traction battery, is workshop work: the diagnosis can
    happen at the car, the repair cannot. A provider quoting a 12 V battery for those
    symptoms is not quoting the job you need.
  </p>

  {
    hasWhatsApp && (
      <p class="inline-cta">
        <WhatsAppButton
          service="battery_prices"
          ctaLocation="service_inline_whatsapp"
          variant="primary"
          label="Get a price for your car"
        />
      </p>
    )
  }

  <h2>Common questions about battery prices</h2>

  <FaqBlock faqs={faqs} />
</ServicePageLayout>

