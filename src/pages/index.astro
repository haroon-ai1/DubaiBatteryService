---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import ServiceSelector from "@/components/sections/ServiceSelector.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import ServiceFeature from "@/components/sections/ServiceFeature.astro";
import PriceEducation from "@/components/sections/PriceEducation.astro";
import BatteryTech from "@/components/sections/BatteryTech.astro";
import AreaInfo from "@/components/sections/AreaInfo.astro";
import FaqAccordion from "@/components/sections/FaqAccordion.astro";
import FinalCTA from "@/components/sections/FinalCTA.astro";
---

<BaseLayout
  title="Dubai Battery Service | Car Battery Help in Dubai"
  description="Practical information on car battery replacement, mobile service, jump-starts and testing for drivers across Dubai."
  path="/"
>
  <Hero />

  <ServiceSelector />

  <HowItWorks />

  <ServiceFeature
    id="replacement"
    heading="The right battery. The right fit."
    motif="battery"
    imageSide="right"
    paragraphs={[
      "A battery replacement only counts as the right fix if the new battery actually matches what the car needs — capacity, chemistry and physical fit matter more than brand name alone.",
      "Vehicles with stop-start technology are the most common mismatch: fitting a conventional starter battery where the manufacturer specifies EFB or AGM tends to shorten its working life dramatically, sometimes within months.",
    ]}
    bullets={[
      "Cold-cranking amps and capacity (Ah) matched to the engine and electrical load",
      "Start-stop vehicles typically require EFB or AGM depending on the manufacturer's specification — AGM is common for more demanding stop-start/recuperation systems and higher electrical loads",
      "Some manufacturers require the new battery to be registered to the car's electrical system after fitting",
    ]}
  />

  <ServiceFeature
    id="mobile-service"
    heading="Delivery, testing and installation — at the car."
    motif="location"
    imageSide="left"
    tone="soft"
    paragraphs={[
      "Mobile battery service generally covers three things at the vehicle's own location: testing an existing battery's health, delivering and installing a replacement, or a straightforward jump-start.",
      "Access matters as much as the service itself — a villa driveway, basement parking in a Downtown tower, and a roadside breakdown each come with different practical constraints worth mentioning upfront.",
    ]}
    bullets={[
      "Testing distinguishes a genuinely failing battery from one that's just temporarily drained",
      "The old battery is typically taken away for recycling as part of a mobile replacement",
      "Basement or multi-storey parking access is worth flagging before a technician arrives",
    ]}
  />

  <ServiceFeature
    id="jump-start"
    heading="Jump-start vs replacement — they're not interchangeable."
    motif="spark"
    imageSide="right"
    paragraphs={[
      "A jump-start restores enough charge to start the engine. It doesn't fix whatever caused the battery to drain in the first place.",
      "If the same car needs jump-starting again within a few days, that's usually a sign the battery — or the alternator — needs proper attention, not another jump.",
    ]}
    bullets={[
      "Works well for a battery drained by lights or accessories left on, or a car left parked unused for an extended period",
      "Doesn't resolve a battery that has genuinely reached the end of its working life",
      "Repeated jump-starts in a short period point to a battery or charging-system fault",
    ]}
  />

  <PriceEducation />

  <BatteryTech />

  <AreaInfo />

  <FaqAccordion />

  <FinalCTA />
</BaseLayout>
