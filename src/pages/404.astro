---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ButtonPrimary from "@/components/buttons/ButtonPrimary.astro";
import ButtonSecondary from "@/components/buttons/ButtonSecondary.astro";
---

<BaseLayout
  title="Page not found | Dubai Battery Service"
  description="This page doesn't exist or may have moved."
  path="/404/"
  robots="noindex, nofollow"
>
  <section class="not-found">
    <div class="container not-found-inner">
      <p class="eyebrow">404</p>
      <h1>That page doesn't exist.</h1>
      <p class="not-found-lead">
        It may have moved, or the link might be out of date. Here's how to find what you were
        looking for.
      </p>
      <div class="not-found-actions">
        <ButtonPrimary href="/">Go home</ButtonPrimary>
        <ButtonSecondary href="/#services">Explore services</ButtonSecondary>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
  }

  .not-found-inner {
    max-width: 34rem;
  }

  .not-found-inner h1 {
    margin-top: 0.75rem;
  }

  .not-found-lead {
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
  }

  .not-found-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
