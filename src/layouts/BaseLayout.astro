---
import "@/styles/global.css";
import { siteConfig } from "@/config/site";
import SeoHead from "@/components/seo/SeoHead.astro";
import JsonLdWebSite from "@/components/seo/JsonLdWebSite.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import StickyMobileCTA from "@/components/layout/StickyMobileCTA.astro";
import Analytics from "@/components/tracking/Analytics.astro";

/**
 * A single LCP image to preload. Pass the SAME srcset strings the page's
 * <picture> uses — a preload that doesn't match what <picture> selects
 * downloads a file nobody renders and makes LCP worse, not better.
 */
export interface PreloadImage {
  srcset: string;
  sizes: string;
  type: string;
  media?: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  robots?: string;
  preloadImages?: PreloadImage[];
  /**
   * Where the header's "Get Battery Help" scroll-CTA points. Defaults to
   * this page's own #get-help section. Pages that don't render one (404)
   * must pass a root-relative "/#get-help" so the button isn't dead.
   */
  helpHref?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  robots,
  preloadImages = [],
  helpHref = "#get-help",
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Self-hosted variable font, preloaded to avoid layout shift / FOIT -->
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />

    {/* LCP image preload — beats the stylesheet to the network queue. */}
    {
      preloadImages.map((img) => (
        <link
          rel="preload"
          as="image"
          imagesrcset={img.srcset}
          imagesizes={img.sizes}
          type={img.type}
          media={img.media}
        />
      ))
    }

    <SeoHead title={title} description={description} path={path} ogImage={ogImage} robots={robots} />
    <JsonLdWebSite />
    <Analytics />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header helpHref={helpHref} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA />
  </body>
</html>
