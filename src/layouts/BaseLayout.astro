---
import "@/styles/global.css";
import { siteConfig } from "@/config/site";
import SeoHead from "@/components/seo/SeoHead.astro";
import JsonLdWebSite from "@/components/seo/JsonLdWebSite.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import StickyMobileCTA from "@/components/layout/StickyMobileCTA.astro";
import Analytics from "@/components/tracking/Analytics.astro";
import type { ServiceId } from "@/lib/services";

/**
 * A single LCP image to preload. Pass the SAME srcset strings the page's
 * <picture> uses, or the preload fetches a file nobody renders.
 */
export interface PreloadImage {
  srcset: string;
  sizes: string;
  type: string;
  media?: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  preloadImages?: PreloadImage[];
  /** Context passed to the sticky mobile CTA's WhatsApp message. */
  stickyService?: ServiceId;
  area?: string | null;
  areaName?: string | null;
  makeName?: string | null;
}

const {
  title,
  description,
  path,
  ogImage,
  ogType = "website",
  robots,
  preloadImages = [],
  stickyService = "battery_service",
  area = null,
  areaName = null,
  makeName = null,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1017" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />
    {
      preloadImages.map((img) => (
        <link rel="preload" as="image" imagesrcset={img.srcset} imagesizes={img.sizes} type={img.type} media={img.media} />
      ))
    }

    <SeoHead title={title} description={description} path={path} ogImage={ogImage} ogType={ogType} robots={robots} />
    <JsonLdWebSite />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA service={stickyService} area={area} areaName={areaName} makeName={makeName} />
  </body>
</html>
