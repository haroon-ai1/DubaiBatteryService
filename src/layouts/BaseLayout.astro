---
import "@/styles/global.css";
import SeoHead from "@/components/seo/SeoHead.astro";
import JsonLdWebSite from "@/components/seo/JsonLdWebSite.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import StickyMobileCTA from "@/components/layout/StickyMobileCTA.astro";
import Analytics from "@/components/tracking/Analytics.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  robots?: string;
}

const { title, description, path, ogImage, robots } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Self-hosted variable font, preloaded to avoid layout shift / FOIT -->
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />

    <SeoHead title={title} description={description} path={path} ogImage={ogImage} robots={robots} />
    <JsonLdWebSite />
    <Analytics />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA />
  </body>
</html>
