---
/*
  Mobile-only floating action bar. In asset mode there's no phone/WhatsApp
  to call, so this stays a single honest action: jump to the service
  selector. Swap in real call/WhatsApp buttons (see site.ts business.*)
  once operationalMode moves past "asset" — see buildTelHref/buildWhatsAppHref.
*/
import { siteConfig, buildTelHref, buildWhatsAppHref } from "@/config/site";

const telHref = buildTelHref(siteConfig.business.phone);
const waHref = buildWhatsAppHref(siteConfig.business.whatsapp);
---

<div class="sticky-cta safe-bottom" id="sticky-mobile-cta" aria-hidden="true" inert>
  <div class="sticky-cta-inner">
    {
      telHref && (
        <a href={telHref} class="btn btn-quiet sticky-btn" data-event="click_call">
          Call
        </a>
      )
    }
    {
      waHref && (
        <a href={waHref} class="btn btn-quiet sticky-btn" data-event="click_whatsapp">
          WhatsApp
        </a>
      )
    }
    <a href="#final-cta" class="btn btn-primary sticky-btn" data-event="service_select">
      Get battery help
    </a>
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: var(--z-sticky-cta);
    background: var(--glass-white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
    padding: 0.5rem;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity var(--dur-standard) var(--ease-standard),
      transform var(--dur-standard) var(--ease-standard);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .sticky-cta {
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }
  }

  .sticky-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .sticky-cta-inner {
    display: flex;
    gap: 0.5rem;
  }

  .sticky-btn {
    flex: 1;
    padding-inline: 0.75rem;
    min-height: 48px;
    font-size: var(--fs-small);
  }

  /* Only used when a real phone/WhatsApp number is configured. */
  .btn-quiet {
    background: var(--bg-main);
    color: var(--text-primary);
    border-color: var(--hairline-strong);
  }

  @media (min-width: 64rem) {
    .sticky-cta {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById("sticky-mobile-cta");
  const hero = document.getElementById("hero");
  const finalCta = document.getElementById("final-cta");
  const supportsInert = "inert" in HTMLElement.prototype;
  const focusables = bar ? Array.from(bar.querySelectorAll("a, button")) : [];

  function setHidden(hidden: boolean) {
    if (!bar) return;
    bar.classList.toggle("is-visible", !hidden);
    bar.setAttribute("aria-hidden", hidden ? "true" : "false");

    if (supportsInert) {
      bar.inert = hidden;
    } else {
      // Fallback: manually pull focusable children out of / back into the
      // tab order for browsers without `inert` support.
      focusables.forEach((el) => {
        if (hidden) el.setAttribute("tabindex", "-1");
        else el.removeAttribute("tabindex");
      });
    }
  }

  if (bar && hero && "IntersectionObserver" in window) {
    let heroVisible = true;
    let finalVisible = false;

    const update = () => setHidden(heroVisible || finalVisible);

    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      update();
    }).observe(hero);

    if (finalCta) {
      new IntersectionObserver(([entry]) => {
        finalVisible = entry.isIntersecting;
        update();
      }).observe(finalCta);
    }
  }
</script>
