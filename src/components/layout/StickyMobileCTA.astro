---
/*
  Fixed two-button bar on phones. Always visible below 64rem except while
  the page's own hero CTAs (#hero) or final CTA (#get-help) are on screen,
  so there are never two sets of the same buttons in view.
*/
import { getCallUrl, getLeadDataAttributes, getWhatsAppUrl } from "@/lib/leads";
import type { ServiceId } from "@/lib/services";

interface Props {
  service?: ServiceId;
  area?: string | null;
  areaName?: string | null;
  makeName?: string | null;
}
const { service = "battery_service", area = null, areaName = null, makeName = null } = Astro.props;

const wa = getWhatsAppUrl({ service, ctaLocation: "sticky_mobile_whatsapp", area, areaName, makeName });
const call = getCallUrl({ ctaLocation: "sticky_mobile_call" });
const waAttrs = getLeadDataAttributes({ event: "click_whatsapp", ctaLocation: "sticky_mobile_whatsapp", service, area });
const callAttrs = getLeadDataAttributes({ event: "click_call", ctaLocation: "sticky_mobile_call", area });
---

{
  (wa || call) && (
    <div class="sticky-cta" id="sticky-cta" data-visible="true">
      {call && (
        <a href={call} class="sc-btn sc-call" {...callAttrs}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2z"
            />
          </svg>
          Call now
        </a>
      )}
      {wa && (
        <a href={wa} class="sc-btn sc-wa" target="_blank" rel="noopener" {...waAttrs}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12.05 21.4a9.36 9.36 0 0 1-4.77-1.3l-.34-.2-3.55.92.95-3.46-.22-.36A9.4 9.4 0 1 1 12.05 21.4zm8-17.39A11.36 11.36 0 0 0 .68 11.98a11.35 11.35 0 0 0 1.53 5.72L.58 23.4l5.83-1.53A11.37 11.37 0 0 0 20.05 4.01zM17.5 14.4c-.3-.15-1.75-.86-2-.96-.28-.1-.48-.15-.68.15-.2.3-.78.96-.96 1.16-.18.2-.36.22-.66.08-.3-.15-1.26-.46-2.4-1.48-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.63-.93-2.23-.24-.58-.5-.5-.68-.5-.2 0-.53.07-.8.38-.28.3-1.06 1.03-1.06 2.52s1.08 2.92 1.23 3.12c.15.2 2.12 3.24 5.14 4.54 1.95.84 2.6.9 3.62.74.58-.09 1.75-.72 2-1.4.25-.7.25-1.28.18-1.4-.08-.14-.28-.22-.58-.36z"
            />
          </svg>
          WhatsApp
        </a>
      )}
    </div>
  )
}

<script is:inline>
  (function () {
    var bar = document.getElementById("sticky-cta");
    if (!bar || !("IntersectionObserver" in window)) return;
    var targets = ["hero", "get-help"]
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean);
    if (!targets.length) return;
    var visible = new Set();
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) visible.add(e.target);
          else visible.delete(e.target);
        });
        bar.dataset.visible = visible.size ? "false" : "true";
      },
      { threshold: 0.35 }
    );
    targets.forEach(function (t) { io.observe(t); });
  })();
</script>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-sticky-cta);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--hairline);
    box-shadow: 0 -8px 24px -12px rgba(11, 16, 23, 0.2);
    transition: transform var(--dur) var(--ease);
  }
  .sticky-cta[data-visible="false"] {
    transform: translateY(110%);
  }
  .sc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.1rem;
    border-radius: var(--radius-pill);
    font-weight: 750;
    text-decoration: none;
  }
  .sc-btn svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .sc-call {
    background: var(--ink);
    color: #fff;
  }
  .sc-wa {
    background: var(--whatsapp-green);
    color: var(--whatsapp-ink);
  }
  @media (min-width: 64rem) {
    .sticky-cta {
      display: none;
    }
  }
</style>
