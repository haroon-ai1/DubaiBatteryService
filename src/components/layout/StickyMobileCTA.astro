---
/*
  Mobile sticky bottom bar. Premium dual-action surface.

  Prefers [WhatsApp][Call] when both are configured. Falls back to a
  single "Get Battery Help →" when neither is, so the bar is never
  useless. Hidden while the hero or final CTA is in view (both already
  present prominent actions), and marked `inert` while hidden so the
  focus order doesn't leak into invisible controls.
*/
import WhatsAppButton from "@/components/actions/WhatsAppButton.astro";
import CallButton from "@/components/actions/CallButton.astro";
import PrimaryHelpButton from "@/components/actions/PrimaryHelpButton.astro";
import { hasCallChannel, hasWhatsAppChannel } from "@/lib/leads";

const hasWhatsApp = hasWhatsAppChannel();
const hasCall = hasCallChannel();
const anyChannel = hasWhatsApp || hasCall;
---

<div class="sticky-cta" id="sticky-mobile-cta" aria-hidden="true" inert>
  <div class="sticky-cta-inner">
    {
      hasWhatsApp && (
        <WhatsAppButton
          service="battery_service"
          ctaLocation="sticky_mobile_whatsapp"
          variant="compact"
          class="sticky-btn"
        />
      )
    }
    {
      hasCall && (
        <CallButton
          ctaLocation="sticky_mobile_call"
          variant="compact"
          class="sticky-btn sticky-btn--dark"
        />
      )
    }
    {
      !anyChannel && (
        <PrimaryHelpButton class="sticky-btn sticky-btn--primary" label="Get Battery Help" />
      )
    }
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 12px;
    right: 12px;
    /* The shared `.safe-bottom` utility was dead here: Astro's scoped
       `.sticky-cta[data-astro-cid-…]` selector outranks it and the
       shorthand `padding` below reset padding-bottom anyway. Handled
       inline instead. */
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: var(--z-sticky-cta);
    background: var(--glass-white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
    padding: 0.5rem;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity var(--dur-standard) var(--ease-standard),
      transform var(--dur-standard) var(--ease-standard);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .sticky-cta {
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }
  }

  .sticky-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .sticky-cta-inner {
    display: flex;
    gap: 0.5rem;
  }

  /* Force every sticky child into flex:1 sizing regardless of the
     button primitive's default padding — we want equal-width dual
     actions in this row. */
  :global(.sticky-btn) {
    flex: 1;
    min-height: 48px !important;
    padding-inline: 0.75rem !important;
    font-size: var(--fs-small) !important;
  }

  :global(.sticky-btn--dark) {
    background: var(--text-primary) !important;
    color: #ffffff !important;
    border-color: var(--text-primary) !important;
  }

  :global(.sticky-btn--dark .call-icon) {
    color: #ffffff !important;
  }

  :global(.sticky-btn--primary) {
    /* fallback single-button treatment */
  }

  @media (min-width: 64rem) {
    .sticky-cta {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById("sticky-mobile-cta");
  const hero = document.getElementById("hero");
  const finalCta = document.getElementById("get-help");
  const supportsInert = "inert" in HTMLElement.prototype;
  const focusables = bar ? Array.from(bar.querySelectorAll("a, button")) : [];

  function setHidden(hidden: boolean) {
    if (!bar) return;
    bar.classList.toggle("is-visible", !hidden);
    bar.setAttribute("aria-hidden", hidden ? "true" : "false");

    if (supportsInert) {
      (bar as HTMLElement & { inert: boolean }).inert = hidden;
    } else {
      focusables.forEach((el) => {
        if (hidden) el.setAttribute("tabindex", "-1");
        else el.removeAttribute("tabindex");
      });
    }
  }

  // On pages with no #hero (the 404), there is nothing to observe — show
  // the bar rather than leaving it permanently inert and invisible.
  if (bar && !hero) {
    setHidden(false);
  } else if (bar && hero && "IntersectionObserver" in window) {
    let heroVisible = true;
    let finalVisible = false;

    const update = () => setHidden(heroVisible || finalVisible);

    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      update();
    }).observe(hero);

    if (finalCta) {
      new IntersectionObserver(([entry]) => {
        finalVisible = entry.isIntersecting;
        update();
      }).observe(finalCta);
    }
  }
</script>
