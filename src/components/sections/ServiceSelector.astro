---
const services = [
  {
    id: "replacement",
    name: "Battery Replacement",
    blurb: "Matching a vehicle to the right battery — capacity, chemistry and fit.",
    icon: "battery",
  },
  {
    id: "jump-start",
    name: "Jump Start",
    blurb: "What a jump-start can and can't fix, and how to tell the difference.",
    icon: "bolt",
  },
  {
    id: "mobile-service",
    name: "Mobile Service",
    blurb: "On-site delivery, testing and installation — without a workshop visit.",
    icon: "delivery",
  },
];
---

<section class="service-selector" id="services">
  <div class="container">
    <div class="section-heading">
      <h2>Simple battery help, without the confusion.</h2>
      <p>Three common situations drivers in Dubai run into — pick the one closest to yours.</p>
    </div>

    <ul class="service-grid">
      {
        services.map((service) => (
          <li>
            <a href={`#${service.id}`} class="service-card" data-event="service_select" data-service={service.id}>
              <span class="service-icon" aria-hidden="true">
                {service.icon === "battery" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="7" width="17" height="10" rx="2.5" stroke="currentColor" stroke-width="1.75" />
                    <path d="M21 10.5V13.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                    <path d="M8 10L6 12.5L8 12.5L6.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {service.icon === "bolt" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M13 3L6 14H11.5L10.5 21L18 10H12.5L13 3Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
                  </svg>
                )}
                {service.icon === "delivery" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 8H15V17H3V8Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
                    <path d="M15 11H18.5L21 14.5V17H15V11Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
                    <circle cx="7" cy="19" r="1.75" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="17.5" cy="19" r="1.75" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                )}
              </span>
              <span class="service-name">{service.name}</span>
              <span class="service-blurb">{service.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .service-selector {
    padding-block: var(--section-space);
  }

  .section-heading {
    max-width: 38rem;
    margin-bottom: clamp(2rem, 1.6rem + 1.6vw, 3rem);
  }

  .section-heading p {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem;
    height: 100%;
    text-decoration: none;
    color: var(--text-primary);
    background: var(--bg-main);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }

  .service-card:active {
    transform: translateY(1px);
  }

  @media (hover: hover) {
    .service-card:hover {
      border-color: var(--border-medium);
      box-shadow: var(--shadow-card);
      transform: translateY(-2px);
    }
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--red-soft);
    color: var(--red-primary);
  }

  .service-icon svg {
    width: 22px;
    height: 22px;
  }

  .service-name {
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .service-blurb {
    color: var(--text-secondary);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
  }
</style>
