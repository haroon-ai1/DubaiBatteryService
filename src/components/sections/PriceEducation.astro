---
const factors = [
  {
    term: "Capacity & cold-cranking amps",
    detail: "Sized to the engine and its electrical load — not simply the largest battery that physically fits.",
  },
  {
    term: "Battery chemistry",
    detail: "Flooded, EFB or AGM — largely determined by the manufacturer's stop-start specification, not personal preference.",
  },
  {
    term: "Start-stop compatibility",
    detail: "Fitting a conventional starter battery where the manufacturer specifies EFB or AGM tends to wear out noticeably faster than its rated life.",
  },
  {
    term: "Vehicle-specific fitment",
    detail: "Physical case size, terminal layout and hold-down design vary by make and model, even within the same brand.",
  },
  {
    term: "Battery registration / coding",
    detail: "Several modern vehicles — commonly German makes — need the replacement battery registered to the car's electrical system.",
  },
  {
    term: "Warranty terms",
    detail: "Coverage length and what's actually included (like heat-related degradation) varies significantly by seller.",
  },
];
---

<section class="price-education" id="pricing">
  <div class="container price-inner">
    <div class="section-heading">
      <h2>What actually determines a battery's price.</h2>
      <p>
        We don't publish invented price figures here — costs vary by seller and vehicle. These are the
        factors that legitimately move the number.
      </p>
    </div>

    <dl class="factor-list">
      {
        factors.map((factor) => (
          <div class="factor-row">
            <dt>{factor.term}</dt>
            <dd>{factor.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .price-education {
    padding-block: var(--section-space);
  }

  .price-inner .section-heading {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .section-heading p {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
  }

  .factor-list {
    display: flex;
    flex-direction: column;
  }

  .factor-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border-light);
  }

  .factor-row:last-child {
    border-bottom: 1px solid var(--border-light);
  }

  @media (min-width: 48rem) {
    .factor-row {
      grid-template-columns: minmax(0, 18rem) 1fr;
      gap: 2rem;
    }
  }

  .factor-row dt {
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .factor-row dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: 34rem;
  }
</style>
