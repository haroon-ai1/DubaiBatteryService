---
/*
  Emergency-first process. Three steps on a single hairline rail —
  horizontal on wide viewports, vertical spine on mobile. Deliberately no
  operational promises: the copy describes what the driver does, not what
  a technician does. Turning this into "arrives in 30 minutes" requires a
  verified operator, which does not exist in this config.
*/
const steps = [
  {
    title: "Describe the issue",
    body: "Make, model and year — plus the symptom. Whether it cranks slowly, clicks or does nothing at all narrows the cause considerably.",
  },
  {
    title: "Share your location",
    body: "Tower basement, villa driveway or hard shoulder. Access decides the equipment and the approach, so it is worth saying up front.",
  },
  {
    title: "Connect with the service provider",
    body: "Enquiries are forwarded to the service provider handling battery requests, who then coordinates directly with you.",
  },
];
---

<section class="section how" id="how-it-works">
  <div class="container">
    <div class="how-head">
      <span class="label">How it works</span>
      <h2>Three steps, <br />before anyone drives out.</h2>
    </div>

    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step">
            <span class="step-index" aria-hidden="true">{`0${i + 1}`.slice(-2)}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-head {
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .how-head .label {
    margin-bottom: 1.25rem;
  }

  .how-head h2 {
    max-width: 20ch;
  }

  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 56rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
      border-top: 1px solid var(--hairline);
    }
  }

  .step {
    position: relative;
    padding-block: 2rem;
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 56rem) {
    .step {
      border-top: none;
      padding-top: 2.25rem;
    }
    .step::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 0;
      width: 2.5rem;
      height: 1px;
      background: var(--red-primary);
    }
  }

  .step-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--red-primary);
    margin-bottom: 1.25rem;
  }

  .step-title {
    font-size: var(--fs-h3);
    max-width: 22ch;
  }

  .step-body {
    margin-top: 0.875rem;
    color: var(--text-secondary);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    max-width: 40ch;
  }
</style>
