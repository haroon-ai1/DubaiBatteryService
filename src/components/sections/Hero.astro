---
/*
  Emergency-first hero. The first viewport answers three questions:
  what is this, where, what can I do.

  ACTION HIERARCHY: WhatsApp is the primary (filled) button and Call sits
  beside it. Previously the loudest element was the red "Get Battery Help"
  button, which is an in-page scroll to #get-help at the very bottom of a
  ten-section page — the single most prominent control on an emergency
  site did nothing but move the viewport. The scroll-CTA is now only the
  fallback for when no channel is configured.

  IMAGE: one <picture>, art-directed with `media`. See src/lib/heroImages.ts
  for why this isn't Astro's <Picture> component.
*/
import WhatsAppButton from "@/components/actions/WhatsAppButton.astro";
import CallButton from "@/components/actions/CallButton.astro";
import PrimaryHelpButton from "@/components/actions/PrimaryHelpButton.astro";
import PartnerDisclosure from "@/components/actions/PartnerDisclosure.astro";
import { hasCallChannel, hasWhatsAppChannel } from "@/lib/leads";
import {
  HERO_ALT,
  HERO_DESKTOP_MEDIA,
  HERO_DESKTOP_SIZES,
  HERO_MOBILE_SIZES,
  heroDesktopSet,
  heroMobileSet,
} from "@/lib/heroImages";

const hasWhatsApp = hasWhatsAppChannel();
const hasCall = hasCallChannel();
---

<section class="hero" id="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="hero-tag">Mobile Car Battery Help in Dubai</span>
      <h1>Car Battery Service <br />in&nbsp;Dubai.</h1>
      <p class="lead hero-lead">
        Battery replacement, jump-start assistance and mobile battery service information
        for drivers across Dubai.
      </p>
      <div class="hero-actions">
        {
          hasWhatsApp ? (
            <WhatsAppButton
              service="battery_service"
              ctaLocation="hero_whatsapp"
              variant="primary"
              label="WhatsApp Now"
              class="hero-primary"
            />
          ) : (
            <PrimaryHelpButton size="large" class="hero-primary" />
          )
        }
        {hasCall && <CallButton ctaLocation="hero_call" variant="quiet" label="Call" />}
      </div>
      <PartnerDisclosure />
    </div>

    <figure class="hero-figure">
      <div class="hero-bloom" aria-hidden="true"></div>
      <picture>
        <source
          media={HERO_DESKTOP_MEDIA}
          type="image/avif"
          srcset={heroDesktopSet.avif}
          sizes={HERO_DESKTOP_SIZES}
        />
        <source
          media={HERO_DESKTOP_MEDIA}
          type="image/webp"
          srcset={heroDesktopSet.webp}
          sizes={HERO_DESKTOP_SIZES}
        />
        <source
          media={HERO_DESKTOP_MEDIA}
          type="image/jpeg"
          srcset={heroDesktopSet.jpg}
          sizes={HERO_DESKTOP_SIZES}
        />
        <source type="image/avif" srcset={heroMobileSet.avif} sizes={HERO_MOBILE_SIZES} />
        <source type="image/webp" srcset={heroMobileSet.webp} sizes={HERO_MOBILE_SIZES} />
        <img
          src={heroMobileSet.fallback}
          srcset={heroMobileSet.jpg}
          sizes={HERO_MOBILE_SIZES}
          alt={HERO_ALT}
          width={heroMobileSet.width}
          height={heroMobileSet.height}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="hero-img"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
    padding-top: clamp(1.75rem, 1rem + 2.5vw, 4rem);
    padding-bottom: clamp(3.5rem, 2rem + 5vw, 7.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1.25rem + 3vw, 3.75rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(3rem, 1rem + 5vw, 5.5rem);
    }
  }

  .hero-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red-primary);
    margin-bottom: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);
  }

  .hero-copy h1 {
    max-width: 14ch;
    font-size: clamp(2.375rem, 1.5rem + 3.75vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero-lead {
    margin-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    max-width: 36ch;
  }

  /* The hero's primary action is now WhatsApp, so it needs the `large`
     sizing the red PrimaryHelpButton used to bring with it. */
  :global(.hero-primary) {
    min-height: 60px !important;
    padding: 1.125rem 2.25rem !important;
    font-size: 1.0625rem !important;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    margin-bottom: 1.25rem;
  }

  .hero-figure {
    position: relative;
    margin: 0;
  }

  /* Soft crimson atmosphere behind the image edge. Reads as light in the
     environment, not as a CSS effect glued on. */
  .hero-bloom {
    position: absolute;
    inset: 6% -14% -12% 4%;
    background: radial-gradient(
      closest-side,
      rgba(226, 28, 53, 0.12) 0%,
      rgba(226, 28, 53, 0.05) 45%,
      rgba(226, 28, 53, 0) 80%
    );
    filter: blur(30px);
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 47.9375rem) {
    .hero-bloom {
      inset: 8% 0 -6% 0;
      background: radial-gradient(
        closest-side,
        rgba(226, 28, 53, 0.09) 0%,
        rgba(226, 28, 53, 0) 72%
      );
    }
  }

  .hero-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    border-radius: var(--radius-img);
  }

  /* Art direction now happens in <picture> via `media`, not by hiding a
     second <img> with CSS — the preload scanner ignores `display: none`
     and fetched both sets. The intrinsic width/height on the <img> is the
     mobile crop (1200x800); the desktop source is 1280x941, so the box is
     given an explicit aspect-ratio per breakpoint to keep CLS at zero. */
  .hero-img {
    aspect-ratio: 1200 / 800;
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .hero-img {
      aspect-ratio: 1280 / 941;
    }
  }
</style>
