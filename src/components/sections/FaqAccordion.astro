---
/*
  Native <details>/<summary> — zero JS, fully keyboard accessible.
  Emits FAQPage JSON-LD from the same array it renders, so schema can
  never describe a question the page doesn't display.
  Questions are aligned with the technical topics covered above: chemistry,
  jump-start diagnostics, registration, fitment. Copy stays accurate — no
  operational promises, no fabricated response times.
*/
const faqs = [
  {
    q: "How do I know whether I need a jump start or battery replacement?",
    a: "If the car starts after a jump but goes flat again within a day or two, or the battery is three to four years old, that generally points to replacement rather than repeated jump-starts. A battery that tests healthy but keeps going flat can also indicate a charging-system fault rather than the battery itself.",
  },
  {
    q: "Can a battery be replaced at the vehicle's location?",
    a: "In most cases, yes — mobile replacement is common and rarely needs a workshop visit. Some vehicles require the new battery to be registered to the car's electrical system, which affects how the job is done rather than where.",
  },
  {
    q: "What is an AGM battery?",
    a: "Absorbent Glass Mat — a sealed lead-acid design that tolerates higher electrical loads and repeated cycling. Commonly specified by manufacturers for more demanding stop-start systems and vehicles with heavier onboard electronics.",
  },
  {
    q: "What is an EFB battery?",
    a: "Enhanced Flooded Battery — a flooded lead-acid design engineered for higher cycling durability than a conventional starter battery. Specified by manufacturers for many stop-start vehicles, though not all: some require AGM instead.",
  },
  {
    q: "Why does my battery keep going flat?",
    a: "Common causes include a parasitic drain pulling current while the car is off, an alternator not fully recharging the battery, frequent short trips that never let it recover, or a battery that has simply reached the end of its service life.",
  },
  {
    q: "Does my car require battery registration?",
    a: "A number of modern vehicles with battery management systems — commonly German makes — require the replacement to be registered or coded so the charging strategy matches the new battery. Whether registration is needed depends on the specific vehicle.",
  },
  {
    q: "How do I identify the correct battery for my car?",
    a: "The existing battery's label is the best starting point: it usually lists group size, capacity and cold-cranking amps, along with the chemistry. Owner's manuals vary in how much they specify, so fitment should be confirmed against reliable vehicle- or manufacturer-specific information.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="section faq" id="faq">
  <div class="container faq-grid">
    <div class="faq-head">
      <span class="label">FAQ</span>
      <h2>Battery questions, <br />answered plainly.</h2>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              <span class="faq-q">{faq.q}</span>
              <span class="faq-mark" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <path
                    d="M3 8H13"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    class="faq-mark-v"
                    d="M8 3V13"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>
            <p class="faq-a">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border-top: 1px solid var(--hairline);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  @media (min-width: 56rem) {
    .faq-grid {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 6vw, 7rem);
      align-items: start;
    }
  }

  .faq-head .label {
    margin-bottom: 1.25rem;
  }

  .faq-list {
    border-top: 1px solid var(--hairline);
  }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(1.25rem, 1rem + 0.6vw, 1.75rem);
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.3;
    max-width: 34ch;
    transition: color var(--dur-standard) var(--ease-standard);
  }

  .faq-mark {
    flex-shrink: 0;
    color: var(--red-primary);
    margin-top: 0.35rem;
  }

  .faq-mark svg {
    width: 16px;
    height: 16px;
  }

  .faq-mark-v {
    transform-origin: center;
    transition: transform var(--dur-standard) var(--ease-standard);
  }

  .faq-item[open] .faq-mark-v {
    transform: rotate(90deg);
  }

  .faq-a {
    padding-bottom: clamp(1.25rem, 1rem + 0.6vw, 1.75rem);
    color: var(--text-secondary);
    font-size: var(--fs-body);
    max-width: 56ch;
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: 3px;
  }

  @media (hover: hover) {
    .faq-item summary:hover .faq-q {
      color: var(--red-primary);
    }
  }
</style>
