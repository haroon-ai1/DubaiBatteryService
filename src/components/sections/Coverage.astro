---
/*
  Dubai coverage — inline, restrained, editorial. Area names are set as a
  large wrapped list, typographic rather than modular. They are plain text
  (not links) because no /areas/ pages exist yet; the internal-link tree
  can be introduced as those pages ship, without touching this layout.

  Copy is careful to describe informational coverage — not dispatched
  operations — while entityVerified is false.
*/
import { siteConfig } from "@/config/site";
---

<section class="section coverage" id="areas">
  <div class="container coverage-grid">
    <div class="coverage-copy">
      <span class="label">Across Dubai</span>
      <h2>Written for how <br />the city actually parks.</h2>
      <p class="lead">
        Tower basement parking, a villa driveway and a hard shoulder are three different
        access problems. Describing them up front decides the equipment brought.
      </p>
    </div>

    <ul class="area-list">
      {siteConfig.serviceAreas.map((area) => <li>{area}</li>)}
    </ul>
  </div>
</section>

<style>
  .coverage {
    overflow-x: clip;
    border-top: 1px solid var(--hairline);
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  @media (min-width: 56rem) {
    .coverage-grid {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 6vw, 7rem);
      align-items: start;
    }
  }

  .coverage-copy .label {
    margin-bottom: 1.25rem;
  }

  .coverage-copy .lead {
    margin-top: 1.25rem;
  }

  .area-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    row-gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .area-list li {
    color: var(--text-primary);
  }
</style>
