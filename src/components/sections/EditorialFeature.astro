---
/*
  Battery Replacement — the page's first heavyweight editorial section.

  Composed typographically, without imagery: the service-photography set
  isn't in place yet, and shipping placeholder art here undercuts the
  premium register. A subtle red bloom sits behind the spec sheet on the
  right; when real replacement photography lands, swap the spec block for
  an art-directed image and keep the rest of the composition.
*/
import PrimaryHelpButton from "@/components/actions/PrimaryHelpButton.astro";
import WhatsAppButton from "@/components/actions/WhatsAppButton.astro";
import { hasWhatsAppChannel } from "@/lib/leads";

const hasWhatsApp = hasWhatsAppChannel();

const spec = [
  { term: "Type", detail: "AGM · EFB · Conventional" },
  { term: "Capacity", detail: "Set by the vehicle, not by preference" },
  { term: "CCA", detail: "Cold-cranking amps — vehicle-specific" },
  { term: "Fitment", detail: "Physical size and terminal layout must match" },
  { term: "Registration", detail: "Required by some modern vehicles" },
];
---

<section class="feature" id="replacement">
  <div class="container feature-grid">
    <div class="feature-copy">
      <span class="label feature-label">
        <span class="feature-index">01</span>
        Battery Replacement
      </span>
      <h2>The right battery <br />matters more than <br />the brand on it.</h2>
      <p class="feature-p">
        Capacity, cold-cranking amps and physical fitment are set by the vehicle, not by
        preference. Fitting a conventional starter battery where the manufacturer specifies
        EFB or AGM is the most common reason a new battery fails early — sometimes within
        months rather than years.
      </p>
      <p class="feature-p">
        Sustained heat is the other factor. High ambient temperatures accelerate the
        chemical wear inside a lead-acid battery, which is why replacement intervals in the
        UAE often run shorter than a manufacturer's rated life suggests elsewhere.
      </p>
      <p class="feature-p">
        Full detail on
        <a href="/car-battery-replacement-dubai/">car battery replacement in Dubai</a> —
        what defines a correct fit, and what a properly-handled job covers on the day.
        If you want the cost side first, see
        <a href="/car-battery-prices-dubai/">car battery prices in Dubai</a>.
      </p>

      <div class="feature-actions">
        <PrimaryHelpButton label="Get Battery Help" />
        {
          hasWhatsApp && (
            <WhatsAppButton
              service="battery_replacement"
              ctaLocation="service_whatsapp"
              variant="quiet"
            />
          )
        }
      </div>
    </div>

    <aside class="spec-card" aria-label="What defines the correct replacement battery">
      <div class="spec-bloom" aria-hidden="true"></div>
      <div class="spec-inner">
        <div class="spec-head">
          <span class="spec-eyebrow">Spec — set by the vehicle</span>
          <span class="spec-dot" aria-hidden="true">◆</span>
        </div>
        <dl class="spec-list">
          {
            spec.map((row) => (
              <div class="spec-row">
                <dt>{row.term}</dt>
                <dd>{row.detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="spec-note">
          A correct fit ultimately requires vehicle-specific fitment information — not
          make/model/year alone.
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .feature {
    position: relative;
    padding-block: var(--section-space);
    overflow-x: clip;
    border-top: 1px solid var(--hairline);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .feature-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(3rem, 1rem + 5vw, 6rem);
    }
  }

  .feature-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .feature-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.14em;
    font-weight: 500;
  }

  .feature-copy h2 {
    max-width: 18ch;
  }

  .feature-copy a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--red-primary);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .feature-copy a:hover {
      color: var(--red-primary);
    }
  }

  .feature-p {
    margin-top: 1.5rem;
    color: var(--text-secondary);
    max-width: var(--measure);
  }

  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 1.5rem + 1vw, 2.5rem);
  }

  .spec-card {
    position: relative;
  }

  .spec-bloom {
    position: absolute;
    inset: -8% -6% -8% -6%;
    background: radial-gradient(
      closest-side,
      rgba(226, 28, 53, 0.10) 0%,
      rgba(226, 28, 53, 0) 76%
    );
    filter: blur(40px);
    z-index: 0;
    pointer-events: none;
  }

  .spec-inner {
    position: relative;
    z-index: 1;
    padding: clamp(1.75rem, 1.5rem + 1.25vw, 2.5rem);
    border-top: 1px solid var(--hairline-strong);
  }

  .spec-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .spec-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .spec-dot {
    font-size: 0.5rem;
    color: var(--red-primary);
  }

  .spec-list {
    margin: 0;
    padding: 0;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--hairline);
  }

  @media (min-width: 30rem) {
    .spec-row {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .spec-row dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .spec-row dd {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .spec-note {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 40ch;
  }
</style>
