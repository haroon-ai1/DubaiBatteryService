---
import ButtonPrimary from "@/components/buttons/ButtonPrimary.astro";
import ButtonSecondary from "@/components/buttons/ButtonSecondary.astro";
---

<section class="final-cta" id="final-cta">
  <div class="container final-cta-inner">
    <div class="final-cta-glow" aria-hidden="true"></div>
    <h2>Figure out what your car actually needs.</h2>
    <p>
      Start with the situation closest to yours — replacement, jump-start, delivery or testing —
      and work from there.
    </p>
    <div class="final-cta-actions">
      <ButtonPrimary href="#services">Compare your options</ButtonPrimary>
      <ButtonSecondary href="#faq">Read the FAQ</ButtonSecondary>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: var(--section-space);
  }

  .final-cta-inner {
    position: relative;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 2rem + 2vw, 4rem) 1rem;
  }

  .final-cta-glow {
    position: absolute;
    inset: -20% 10%;
    background: radial-gradient(closest-side, rgba(226, 28, 53, 0.1) 0%, rgba(226, 28, 53, 0) 70%);
    z-index: -1;
  }

  .final-cta-inner p {
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
  }

  .final-cta-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
