---
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/" or "/car-battery-replacement-dubai/" — absolute canonical is built from siteConfig.siteUrl */
  path: string;
  ogImage?: string;
  robots?: string;
}

const {
  title,
  description,
  path,
  ogImage = siteConfig.defaultOgImage,
  robots = "index, follow",
} = Astro.props;

const canonicalUrl = new URL(path, siteConfig.siteUrl).toString();
const absoluteOgImage = new URL(ogImage, siteConfig.siteUrl).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:locale" content={siteConfig.locale.replace("-", "_")} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />

{
  siteConfig.analytics.googleSiteVerification && (
    <meta
      name="google-site-verification"
      content={siteConfig.analytics.googleSiteVerification}
    />
  )
}
