---
// Renders nothing unless entityVerified is explicitly true AND a business
// name is configured. We do not fabricate an Organization entity just
// because the site has a name, and moving out of "asset" mode is not
// itself treated as proof — see entityVerified in site.ts.
import { siteConfig, hasVerifiedEntity } from "@/config/site";

const { business } = siteConfig;
const canRender = hasVerifiedEntity && Boolean(business.businessName);

const json = canRender
  ? {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: business.businessName,
      legalName: business.legalName ?? undefined,
      url: siteConfig.siteUrl,
      email: business.email ?? undefined,
      telephone: business.phone ?? undefined,
      address: business.address ?? undefined,
    }
  : null;
---

{canRender && <script is:inline type="application/ld+json" set:html={JSON.stringify(json)} />}
