---
// Only import/use this on pages that visibly render a matching <Breadcrumbs>
// trail (service pages, area pages, guides). Never include it on the
// homepage or any page without a real breadcrumb UI — schema must match
// visible content.
import { siteConfig } from "@/config/site";

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const json = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.path, siteConfig.siteUrl).toString(),
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(json)} />
