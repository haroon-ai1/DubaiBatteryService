---
/*
  Renders a tel: CTA — or nothing at all, if no callable number is
  configured. Prefers a call-tracking DID when enabled; falls back to the
  partner's raw call number otherwise (see `getCallUrl()`).
*/
import { getCallUrl } from "@/lib/leads";
import type { AreaId, CtaLocation } from "@/lib/services";

interface Props {
  ctaLocation: CtaLocation;
  area?: AreaId | null;
  variant?: "quiet" | "compact";
  label?: string;
  class?: string;
}

const {
  ctaLocation,
  area = null,
  variant = "quiet",
  label = "Call",
  class: className = "",
} = Astro.props;

const href = getCallUrl({ ctaLocation });
---

{
  href && (
    <a
      href={href}
      class:list={["call-btn", `call-btn--${variant}`, className]}
      data-lead-event="click_call"
      data-lead-cta={ctaLocation}
      data-lead-area={area ?? ""}
    >
      <svg class="call-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2z"
        />
      </svg>
      <span>{label}</span>
    </a>
  )
}

<style>
  .call-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.9375rem 1.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline-strong);
    background: transparent;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.005em;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-standard),
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard);
  }

  .call-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--text-secondary);
  }

  .call-btn:active {
    transform: translateY(1px);
  }

  @media (hover: hover) {
    .call-btn:hover {
      border-color: var(--text-primary);
      background: var(--text-primary);
      color: #ffffff;
    }
    .call-btn:hover .call-icon {
      color: #ffffff;
    }
  }

  .call-btn--compact {
    min-height: 48px;
    padding: 0.625rem 1rem;
    font-size: var(--fs-small);
  }
</style>
