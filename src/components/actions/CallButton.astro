---
/*
  tel: CTA — renders nothing when no callable number is configured.
  Prefers a call-tracking DID when enabled (see `getCallUrl()`).
*/
import { getCallUrl, getLeadDataAttributes } from "@/lib/leads";
import type { AreaId, CtaLocation } from "@/lib/services";

interface Props {
  ctaLocation: CtaLocation;
  area?: AreaId | null;
  variant?: "ghost" | "ghost-ink" | "ink" | "volt";
  label?: string;
  /** Show the dialled number instead of `label`. */
  showNumber?: boolean;
  size?: "sm" | "md" | "lg";
  block?: boolean;
  class?: string;
}

const {
  ctaLocation,
  area = null,
  variant = "ghost",
  label = "Call now",
  showNumber = false,
  size = "md",
  block = false,
  class: className = "",
} = Astro.props;

const href = getCallUrl({ ctaLocation });
const leadAttrs = getLeadDataAttributes({ event: "click_call", ctaLocation, area });

/* +971582424859 -> +971 58 242 4859 (UAE mobile grouping). */
function pretty(tel: string): string {
  const d = tel.replace(/^tel:\+?/, "");
  const m = d.match(/^971(\d{2})(\d{3})(\d{4})$/);
  return m ? `+971 ${m[1]} ${m[2]} ${m[3]}` : `+${d}`;
}
const text = href && showNumber ? pretty(href) : label;
---

{
  href && (
    <a
      href={href}
      class:list={["btn", `btn--${variant}`, size !== "md" && `btn--${size}`, block && "btn--block", className]}
      {...leadAttrs}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2z"
        />
      </svg>
      <span>{text}</span>
    </a>
  )
}
