---
/*
  WhatsApp CTA — renders nothing when no partner WhatsApp number is
  configured. Never build wa.me URLs elsewhere; use `getWhatsAppUrl()`.
*/
import { getLeadDataAttributes, getWhatsAppUrl } from "@/lib/leads";
import type { AreaId, CtaLocation, ServiceId } from "@/lib/services";

interface Props {
  service: ServiceId;
  ctaLocation: CtaLocation;
  area?: AreaId | null;
  areaName?: string | null;
  makeName?: string | null;
  label?: string;
  size?: "sm" | "md" | "lg";
  block?: boolean;
  class?: string;
}

const {
  service,
  ctaLocation,
  area = null,
  areaName = null,
  makeName = null,
  label = "WhatsApp us",
  size = "md",
  block = false,
  class: className = "",
} = Astro.props;

const href = getWhatsAppUrl({ service, area, ctaLocation, areaName, makeName });
const leadAttrs = getLeadDataAttributes({ event: "click_whatsapp", ctaLocation, service, area });
---

{
  href && (
    <a
      href={href}
      class:list={["btn", "btn--wa", size !== "md" && `btn--${size}`, block && "btn--block", className]}
      target="_blank"
      rel="noopener"
      {...leadAttrs}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M17.5 14.4c-.3-.15-1.75-.86-2-.96-.28-.1-.48-.15-.68.15-.2.3-.78.96-.96 1.16-.18.2-.36.22-.66.08-.3-.15-1.26-.46-2.4-1.48-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.63-.93-2.230-.24-.58-.5-.5-.68-.5H8c-.2 0-.53.07-.8.38-.28.3-1.06 1.03-1.06 2.52 0 1.48 1.08 2.92 1.230 3.12.15.2 2.12 3.24 5.14 4.54.72.31 1.28.5 1.72.63.72.23 1.38.2 1.9.12.58-.09 1.75-.72 2-1.4.25-.7.25-1.28.18-1.4-.08-.14-.28-.22-.58-.36zM12.05 21.4h-.03a9.360 9.360 0 0 1-4.77-1.3l-.34-.2-3.55.92.95-3.46-.22-.36a9.34 9.34 0 0 1-1.44-4.98A9.4 9.4 0 0 1 12.06 2.6a9.36 9.36 0 0 1 6.65 2.75 9.35 9.35 0 0 1 2.75 6.66c0 5.18-4.22 9.4-9.4 9.4zm7.99-17.39A11.36 11.36 0 0 0 12.05.6C5.78.6.68 5.7.68 11.98a11.35 11.35 0 0 0 1.53 5.72L.58 23.4l5.83-1.53a11.4 11.4 0 0 0 5.63 1.44h.01c6.27 0 11.37-5.1 11.37-11.37 0-3.04-1.18-5.9-3.34-8.05z"
        />
      </svg>
      <span>{label}</span>
    </a>
  )
}
