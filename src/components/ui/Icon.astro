---
/*
  Inline stroke icons (24px grid, currentColor). Inline so there is no
  icon font or sprite request — each page only ships the paths it uses.
*/
export type IconName =
  | "battery"
  | "bolt"
  | "van"
  | "gauge"
  | "siren"
  | "tag"
  | "clock"
  | "shield"
  | "pin"
  | "wrench"
  | "car"
  | "arrow"
  | "check"
  | "card"
  | "recycle"
  | "chat"
  | "sun"
  | "book"
  | "building";

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;

const P: Record<IconName, string> = {
  battery:
    '<rect x="2.5" y="7" width="19" height="13" rx="2"/><path d="M6.5 7V4.5h3V7M14.5 7V4.5h3V7"/><path d="M6 13.5h3M7.5 12v3M15 13.5h3"/>',
  bolt: '<path d="M13 2.5 5 13.5h6l-1 8 8-11h-6l1-8Z"/>',
  van: '<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/>',
  gauge:
    '<path d="M4.2 17.5a8.5 8.5 0 1 1 15.6 0"/><path d="m12 13 4-4"/><circle cx="12" cy="13" r="1.3"/>',
  siren:
    '<path d="M6 18v-5a6 6 0 1 1 12 0v5"/><path d="M4 18h16v2.5H4zM12 2.5v2M4.2 5.2l1.4 1.4M19.8 5.2l-1.4 1.4"/>',
  tag: '<path d="M3 12.2V3.5h8.7l9 9-8.7 8.7-9-9Z"/><circle cx="7.5" cy="8" r="1.4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  shield: '<path d="M12 2.8 4 6v5.6c0 4.6 3.3 8.2 8 9.6 4.7-1.4 8-5 8-9.6V6l-8-3.2Z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  pin: '<path d="M12 21.5s-7-6.2-7-11.5a7 7 0 1 1 14 0c0 5.3-7 11.5-7 11.5Z"/><circle cx="12" cy="10" r="2.5"/>',
  wrench:
    '<path d="M14.7 6.3a4 4 0 0 0 5 5L21 12.6a6 6 0 0 1-7.4 1.8l-6.9 6.9a2.1 2.1 0 1 1-3-3l6.9-6.9A6 6 0 0 1 12.4 4l1.3 1.3Z"/>',
  car: '<path d="M3.5 16.5v-4l2-5.5h13l2 5.5v4"/><path d="M2.5 12.5h19v4h-19z"/><circle cx="7" cy="17.8" r="1.7"/><circle cx="17" cy="17.8" r="1.7"/>',
  arrow: '<path d="M4.5 12h14.5M13.5 6.5 19 12l-5.5 5.5"/>',
  check: '<path d="m5 12.5 4.2 4.2L19 7"/>',
  card: '<rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 10h19M6 14.5h4"/>',
  recycle:
    '<path d="m7 19.5-3.2-5.5 2.1-3.6M17 19.5H10.5M20.2 14 17 8.5l-4.2.1M9 5l3-1.5 3.3 5.2"/><path d="m4 14 1.9-3.6L2.6 9.8M13.5 22l-3-2.5 3-2.5M18.5 5.5l-1.5 3 3.3.7"/>',
  chat: '<path d="M4 5.5h16v10H9l-5 4v-14Z"/><path d="M8 10h8"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/>',
  book: '<path d="M4 4.5h6.5A2.5 2.5 0 0 1 13 7v13a2 2 0 0 0-2-2H4ZM20 4.5h-4.5A2.5 2.5 0 0 0 13 7"/><path d="M20 4.5V18h-7"/>',
  building: '<path d="M4 21V4.5h10V21M14 9h6v12"/><path d="M7 8h1.5M10 8h1.5M7 11.5h1.5M10 11.5h1.5M7 15h1.5M10 15h1.5M2.5 21h19"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={P[name]}
/>
