---
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<a href="/" class:list={["logo", inverse && "logo--inverse"]} aria-label="Dubai Battery Service — home">
  <span class="logo-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M13.2 2.5 5.5 13.6h5.6l-1 7.9 8.4-11.3h-5.9l.6-7.7Z" fill="currentColor" /></svg>
  </span>
  <span class="logo-text">
    <span class="logo-name">Dubai Battery<span class="logo-accent"> Service</span></span>
    <span class="logo-sub">Mobile car battery help</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-primary);
    flex-shrink: 0;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.7rem;
    background: var(--ink);
    color: var(--volt);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .logo--inverse .logo-mark {
    background: var(--volt);
    color: var(--ink);
  }
  .logo-mark svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .logo-text {
    display: grid;
    line-height: 1.1;
  }
  .logo-name {
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }
  .logo-sub {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .logo--inverse {
    color: #fff;
  }
  .logo--inverse .logo-sub {
    color: var(--text-on-ink-3);
  }
  @media (max-width: 22rem) {
    .logo-accent {
      display: none;
    }
  }
</style>
