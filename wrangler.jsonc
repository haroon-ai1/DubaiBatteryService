{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "dubaibatteryservice",
  "compatibility_date": "2026-08-31",

  // Assets-only Worker: no server-side script, Astro's static ./dist output
  // is served directly. "404-page" makes Cloudflare serve dist/404.html for
  // any unmatched route instead of a blank platform 404.
  "assets": {
    "directory": "./dist",
    // Serves dist/404.html with a real 404 status for unmatched routes
    // instead of a blank platform page.
    "not_found_handling": "404-page",
    // Pinned rather than left on the "auto" default so it provably matches
    // astro.config.mjs `trailingSlash: "always"`. Without this, /page and
    // /page/ can both resolve and split signals across two URLs.
    "html_handling": "force-trailing-slash"
  }
}
